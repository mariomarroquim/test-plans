<% if flash[:info].present? %>
  <div class="alert alert-important alert-info alert-dismissible d-print-none mb-4" role="alert">
    <div class="alert-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon alert-icon icon-2"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M12 9h.01"/><path d="M11 12h1v4h1"/></svg>
    </div>

    <strong><%= flash[:info] %></strong>
    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
  </div>
<% elsif flash[:alert].present? %>
  <div class="alert alert-important alert-warning alert-dismissible d-print-none mb-4" role="alert">
    <div class="alert-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-alert-triangle"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v4"/><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/><path d="M12 16h.01"/></svg>
    </div>

    <strong><%= flash[:alert] %></strong>
    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
  </div>
<% elsif flash[:notice].present? %>
  <div class="alert alert-important alert-success alert-dismissible d-print-none mb-4" role="alert">
    <div class="alert-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-checks"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 12l5 5l10 -10"/><path d="M2 12l5 5m5 -5l5 -5"/></svg>
    </div>

    <strong><%= flash[:notice] %></strong>
    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
  </div>
<% end %>
