<div class="page-header mt-0 mb-4">
  <%= render "application/messages" %>

  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">Test plan details</h2>
    </div>

    <div class="col-auto d-print-none">
      <div class="d-flex">
        <%= link_to "Clone", new_test_plan_path(test_plan_id: @test_plan.id), class: "btn btn-outline-primary ms-3" %>
        <%= link_to "Update", edit_test_plan_path(@test_plan), class: "btn btn-primary ms-3" %>
        <%= button_to "Remove", @test_plan, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger ms-3" %>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <%= render "test_plans/details", test_plan: @test_plan, truncate_text: false %>
</div>

<div class="row align-items-center mb-4">
  <div class="col">
    <h3 class="page-title">Test runs</h3>
  </div>

  <div class="col-auto d-print-none">
    <div class="d-flex">
      <%= link_to "Add test run", new_test_run_url(test_plan_id: @test_plan.id), class: "btn btn-primary ms-3" %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if @test_runs.present? %>
      <table class="table table-nowrap table-vcenter table-responsive">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Release / branch</th>
            <th scope="col">Result</th>
            <th scope="col">Run at</th>
            <th scope="col" class="d-print-none">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @test_runs.each do |test_run| %>
            <tr>
              <th scope="row"><%= test_run.id %></th>
              <td><%= truncate test_run.revision %></td>

              <td>
                <% if test_run.passed? %>
                  <span class="status status-green">Passed</span>
                <% else %>
                  <span class="status status-yellow">Failed</span>
                <% end %>
              </td>

              <td><%= test_run.created_at.strftime("%y/%m/%d %H:%M") %></td>
              <td class="d-print-none"><%= link_to "Details", test_run %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render "application/empty_state" %>
    <% end %>
  </div>
</div>
