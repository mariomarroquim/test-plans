<div class="text-center">
  <h1 class="mt-3 mb-4">QA, level up your deliveries and get more visibility!</h1>
  <h3 class="mb-6">Manage your test plans, runs, and evidence with Test Plans</h3>

  <p>
    <%= link_to new_registration_path, class: "btn btn-primary btn-lg", role: "button" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-arrow-big-right-line icon-pulse"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12.089 3.634a2 2 0 0 0 -1.089 1.78l-.001 2.586h-4.999a1 1 0 0 0 -1 1v6l.007 .117a1 1 0 0 0 .993 .883l4.999 -.001l.001 2.587a2 2 0 0 0 3.414 1.414l6.586 -6.586a2 2 0 0 0 0 -2.828l-6.586 -6.586a2 2 0 0 0 -2.18 -.434l-.145 .068z"/><path d="M3 8a1 1 0 0 1 .993 .883l.007 .117v6a1 1 0 0 1 -1.993 .117l-.007 -.117v-6a1 1 0 0 1 1 -1z"/></svg>
      Sign up. It's free!
    <% end %>

    <%= link_to new_session_path, class: "btn btn-lg ms-3", role: "button" do %>
      Or sign in
    <% end %>
  </p>
</div>

<div class="row row-deck mt-6">
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Test plans</h5>
        <p class="card-text">Manage and organize all your test plans and runs in one place by product/feature and use case.</p>
      </div>
    </div>
  </div>

  <p class="d-md-none"></p>

  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Test runs</h5>
        <p class="card-text">Document test runs by release/branch, export evidence, and level up deliveries to gain visibility.</p>
      </div>
    </div>
  </div>

  <p class="d-md-none"></p>

  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">It's free!</h5>
        <p class="card-text">Manage unlimited test plans for free. Upgrade to Pro when you need it. Cancel anytime.</p>
      </div>
    </div>
  </div>
</div>

<div class="card d-flex flex-column d-none d-md-block mt-3">
  <div class="row row-0 flex-fill">
    <div class="col-md-4">
      <%= image_tag "screenshot_1.png", alt: "Test Plans screenshot", class: "w-100 h-100 object-cover" %>
    </div>

    <div class="col">
      <div class="card-body h-100 d-flex flex-column">
        <h2>Test Plans is simple and easy to use</h2>

        <div class="text-secondary">
          Think of Test Plans as a powerful, secure, and fast "Excel for QA." Its intuitive interface lets you organize and track test plans easily, handle thousands of cases reliably, and generate reports that turn testing from a routine task into a real competitive advantage.
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card d-flex flex-column d-none d-md-block mt-3">
  <div class="row row-0 flex-fill">
    <div class="col">
      <div class="card-body h-100 d-flex flex-column">
        <h2>Test Plans gives you metrics and insights</h2>

        <div class="text-secondary">
          Tracking test run history gives QA a strategic edge. It reveals coverage gaps, test stability, and delivery confidence. Historical data creates accountability and objective metrics, enabling data-driven release decisions and insight into code health across versions.
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <%= image_tag "screenshot_2.png", alt: "Test Plans screenshot", class: "w-100 h-100 object-cover" %>
    </div>
  </div>
</div>

<div class="card d-flex flex-column d-none d-md-block mt-3">
  <div class="row row-0 flex-fill">
    <div class="col-md-4">
      <%= image_tag "screenshot_3.png", alt: "Test Plans screenshot", class: "w-100 h-100 object-cover" %>
    </div>

    <div class="col">
      <div class="card-body h-100 d-flex flex-column">
        <h2>Test Plans elevates your visibility and influence</h2>

        <div class="text-secondary">
          Documenting every test run turns QA into a true business partner. Detailed execution records, observations, and reports validate functionality, boost credibility, and show QA's key role in reliable delivery—raising visibility, influence, and confidence across the company.
        </div>
      </div>
    </div>
  </div>
</div>

<div class="text-center d-none d-md-block">
  <%= link_to new_registration_path, class: "btn btn-primary btn-lg mt-6 mb-2", role: "button" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-arrow-big-right-line icon-pulse"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12.089 3.634a2 2 0 0 0 -1.089 1.78l-.001 2.586h-4.999a1 1 0 0 0 -1 1v6l.007 .117a1 1 0 0 0 .993 .883l4.999 -.001l.001 2.587a2 2 0 0 0 3.414 1.414l6.586 -6.586a2 2 0 0 0 0 -2.828l-6.586 -6.586a2 2 0 0 0 -2.18 -.434l-.145 .068z"/><path d="M3 8a1 1 0 0 1 .993 .883l.007 .117v6a1 1 0 0 1 -1.993 .117l-.007 -.117v-6a1 1 0 0 1 1 -1z"/></svg>
    Sign up. It's free!
  <% end %>
</div>
